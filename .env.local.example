# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; never commit real keys.

# Absolute URL of this app, used for auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS and every table/function grant entirely — used in exactly
# one place, lib/supabase/service.ts, by trusted server-only code (the
# LiveKit webhook handler; claim_speaker_seat/end_speaker_seat). Treat this
# as a full database admin credential, never the anon key's equal. Not
# required for the app to run day to day — only for the LiveKit webhook
# route and the issue #13 integration tests that exercise it (those skip
# gracefully if this is unset). Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit project settings (used once the live speaker room is implemented)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=
